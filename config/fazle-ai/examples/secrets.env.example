# Fazle-AI secrets configuration (REFERENCE SCHEMA ONLY — no real values)
# --------------------------------------------------------------------------
# Copy to secrets.env (NOT this filename) and populate per environment.
# Every entry in this file is a *_REF placeholder; the resolver in
# policy_loader and the per-app config code looks up the matching key in
# this file OR (in a future deployment) in Vault at the vault:// URI shown.
#
# RULES (enforced by policy_loader and secret-handling tests):
#   1. NEVER put a real key/token/password here -- this file is tracked.
#   2. Every entry must end in _REF and have a vault:// URI as value.
#   3. The runtime reads from a local secrets.env (gitignored) OR from
#      Vault. If the local file is missing the vault:// entry, startup
#      fails closed with a non-secret ValidationError.
#   4. NEVER log the value of any key resolved from here.
# --------------------------------------------------------------------------

# ── Owner / Admin coding workflow (hermes-runner) ────────────────────────
OMNIROUTE_API_KEY_REF=vault://fazle-ai/workloads/hermes-runner/omniroute-api-key
TAVILY_API_KEY_REF=vault://fazle-ai/workloads/hermes-runner/tavily-api-key
HERMES_RUNNER_SECRET_REF=vault://fazle-ai/workloads/hermes-runner/runner-secret
HERMES_RUNNER_CUSTOMER_SECRET_REF=vault://fazle-ai/workloads/hermes-runner/runner-customer-secret

# ── Fazle-Core LLM (for future cutover, not in scope today) ───────────
FAZLE_CORE_OMNIROUTE_API_KEY_REF=vault://fazle-ai/workloads/fazle-core/omniroute-api-key
FAZLE_CORE_GROQ_API_KEY_REF=vault://fazle-ai/workloads/fazle-core/groq-api-key
FAZLE_CORE_MINIMAX_API_KEY_REF=vault://fazle-ai/workloads/fazle-core/minimax-api-key
FAZLE_CORE_GITHUB_TOKEN_REF=vault://fazle-ai/workloads/fazle-core/github-token

# ── Open WebUI (for future cutover, not in scope today) ────────────────
OPENWEBUI_OMNIROUTE_API_KEY_REF=vault://fazle-ai/workloads/open-webui/omniroute-api-key

# ── Media processor (for future cutover, not in scope today) ─────────
MEDIA_PROCESSOR_OMNIROUTE_API_KEY_REF=vault://fazle-ai/workloads/media-processor/omniroute-api-key

# ── Database URLs (non-secret-host only; the secret is the password) ────
# Real DB connection strings live in secrets.env (gitignored).
FAZLE_CORE_DB_URL_REF=vault://fazle-ai/databases/fazle-core/url
ASSISTANT_DB_URL_REF=vault://fazle-ai/databases/assistant/url
