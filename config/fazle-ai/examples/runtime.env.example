# Fazle-AI runtime configuration (non-secret)
# --------------------------------------------------------------------------
# Copy to runtime.env (NOT this filename) and edit per environment.
# Values here are NON-SECRET only: hosts, ports, log levels, feature flags,
# policy-file paths, timeouts.
#
# All credentials go into a SEPARATE secrets.env. See
# config/fazle-ai/examples/secrets.env.example for the reference schema.
# --------------------------------------------------------------------------

# ── Workload identity ────────────────────────────────────────────────────
# Used by policy_loader and shared with structured logs.
WORKLOAD_NAME=hermes-runner
ENVIRONMENT=production

# ── Service bind addresses ───────────────────────────────────────────────
HERMES_RUNNER_HOST=127.0.0.1
HERMES_RUNNER_PORT=8093
HERMES_RUNNER_INTERNAL_HOST=127.0.0.1
HERMES_RUNNER_INTERNAL_PORT=8093

# ── Local Ollama ──────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_HTTP_MAX_CONNECTIONS=16
OLLAMA_HTTP_MAX_KEEPALIVE_CONNECTIONS=8

# ── Local AI gateway (loopback only) ────────────────────────────────────
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DESTINATION=stderr

# ── Policy / config paths ────────────────────────────────────────────────
# When POLICIES_ENABLED=true, the loader reads these paths and validates
# them. When POLICIES_ENABLED=false (default), the runtime uses the legacy
# env-only configuration unchanged. This preserves backward compatibility.
POLICIES_ENABLED=false
POLICY_FILE=/etc/fazle-ai/policy.yaml
WORKLOAD_CONFIG_DIR=/etc/fazle-ai/workloads
SECRETS_FILE=/etc/fazle-ai/secrets.env

# ── Timeouts ──────────────────────────────────────────────────────────────
REQUEST_TIMEOUT_S=30
CONNECT_TIMEOUT_S=5
READ_BUDGET_TOTAL_S=300

# ── Feature flags ────────────────────────────────────────────────────────
FAIL_CLOSED_ON_AUTH_FAILURE=true
EMIT_HEALTH_SIGNAL_ON_AUTH_FAILURE=true
DISABLE_AUTO_ROUTING=true      # belt-and-suspenders: auto/* never reachable
ALLOW_LOCAL_OLLAMA_FALLBACK=true

# ── Health endpoint ──────────────────────────────────────────────────────
HEALTH_ENDPOINT_ENABLED=true
HEALTH_ENDPOINT_PATH=/health
